<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>mineorc</AssemblyName>
    <ApplicationIcon>..\assets\logo.ico</ApplicationIcon>
    <PackageId>MineOrc</PackageId>
    <Version>0.1.0</Version>
    <Title>Minecraft Orchestrator</Title>
    <Description>Minecraft Orchestrator</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Downloader" Version="4.0.3" />
    <PackageReference Include="JetBrains.Annotations" Version="2025.2.4" />
    <PackageReference Include="Meziantou.Framework.ByteSize" Version="2.1.8" />
    <PackageReference Include="Microsoft.CodeAnalysis.ResxSourceGenerator" Version="5.0.0-1.25277.114">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Spectre.Console" Version="0.54.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MineOrc.Foundation\MineOrc.Foundation.csproj" />
    <ProjectReference Include="..\MineOrc.Management\MineOrc.Management.csproj" />
    <ProjectReference Include="..\MineOrc.Platforms.Fabric\MineOrc.Platforms.Fabric.csproj" />
    <ProjectReference Include="..\MineOrc.Security\MineOrc.Security.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Texts.resx" EmitFormatMethods="true">
    </EmbeddedResource>
    <None Remove="Resources\Secrets.json" />
    <EmbeddedResource Include="Resources\Secrets.json" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\assets\logo.ico">
      <Link>logo.ico</Link>
    </None>
  </ItemGroup>

</Project>
