<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>mineorc</AssemblyName>
    <ApplicationIcon>..\assets\logo.ico</ApplicationIcon>
    <PackageId>MineOrc</PackageId>
    <Version>0.1.0</Version>
    <Title>Minecraft Orchestrator</Title>
    <Authors>WithLithum &amp; contributors</Authors>
    <Description>Minecraft Orchestrator</Description>
    <Copyright>Copyright (C) 2025 WithLithum &amp; contributors</Copyright>
    <Company>MineOrc</Company>
    <Product>Minecraft Orchestrator</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Downloader" Version="4.0.3" />
    <PackageReference Include="JetBrains.Annotations" Version="2025.2.4" />
    <PackageReference Include="Meziantou.Framework.ByteSize" Version="2.1.8" />
    <PackageReference Include="SmartFormat" Version="3.6.1" />
    <PackageReference Include="Spectre.Console" Version="0.54.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MineOrc.Foundation\MineOrc.Foundation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Texts.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Texts.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\Texts.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Texts.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\assets\logo.ico">
      <Link>logo.ico</Link>
    </None>
  </ItemGroup>

</Project>
